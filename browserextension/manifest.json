{
  "manifest_version": 3,
  "name": "LMS Learning Tracker & Auto-Login",
  "version": "1.0.0",
  "description": "Automated provider login with Microsoft Graph OTP and active learning hours tracker for Emergere LMS.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://*.udemy.com/*",
    "https://*.coursera.org/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content_scripts/lms_bridge.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.udemy.com/*",
        "https://*.coursera.org/*"
      ],
      "js": ["content_scripts/provider_login.js", "content_scripts/video_tracker.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": ["content_scripts/outlook_otp_reader.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LMS Learning Tracker",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "128": "icons/icon.svg"
  }
}
